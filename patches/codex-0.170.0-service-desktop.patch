+fn private_desktop_startup_name(name: &str) -> Result<Vec<u16>> {
+    let station = unsafe { GetProcessWindowStation() };
+    if station.is_null() {
+        anyhow::bail!("GetProcessWindowStation failed: {}", unsafe { GetLastError() });
+    }
+    let mut needed = 0;
+    unsafe { GetUserObjectInformationW(station, UOI_NAME, ptr::null_mut(), 0, &mut needed) };
+    if needed == 0 {
+        anyhow::bail!("GetUserObjectInformationW size failed: {}", unsafe { GetLastError() });
+    }
+    let mut station_name = vec![0_u16; (needed as usize).div_ceil(2)];
+    if unsafe {
+        GetUserObjectInformationW(station, UOI_NAME, station_name.as_mut_ptr().cast(), needed, &mut needed)
+    } == 0 {
+        anyhow::bail!("GetUserObjectInformationW name failed: {}", unsafe { GetLastError() });
+    }
+    let end = station_name.iter().position(|c| *c == 0).unwrap_or(station_name.len());
+    let station_name = String::from_utf16(&station_name[..end])?;
+    Ok(to_wide(format!("{station_name}\\{name}")))
+}
